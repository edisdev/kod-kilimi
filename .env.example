# ── Sunucu tarafı (tarayıcıya İNMEZ) ─────────────────────────────
# Supabase — Project Settings > API
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."

# pr_number / pr_status sütunlarına yazmak için gerekli.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Pull request'i açan GitHub App.
# Özel anahtar PKCS#8 biçiminde olmalı:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in anahtar.pem -out anahtar.pkcs8.pem
GITHUB_APP_ID="123456"
GITHUB_APP_INSTALLATION_ID="12345678"
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="uzun-rastgele-metin"

# ── Tarayıcıya inen (gizli değil) ────────────────────────────────
NUXT_PUBLIC_REPO="edisdev/kod-kilimi"
NUXT_PUBLIC_SITE_URL="https://kodkilimi.com"
